DISCORD_BOT_TOKEN=your_bot_token_here
# Владелец бота (@wutshy) — для /owner on|off (глобальный «Обзыватель»)
# DISCORD_BOT_OWNER_ID=123456789012345678

# Рекомендуется: ID вашего сервера — slash-команды появятся сразу
# DISCORD_GUILD_ID=123456789012345678

# Устаревшее: жёсткие ID каналов (если не используете /bot setup)
# DISCORD_FORUM_CHANNEL_ID=
# DISCORD_LIST_FORUM_CHANNEL_ID=

# Message Content Intent для !aa / !animeadd в чате
# DISCORD_MESSAGE_CONTENT_INTENT=0

# YummyAnime API (api.yani.tv): https://yummyani.me/dev/applications
# YUMMY_APPLICATION_TOKEN=ваш_X_Application_токен
# YUMMY_SYNC_INTERVAL_SEC=600

# Роль модераторов бота (доступ к /admin без права «Администратор»)
# DISCORD_ADMIN_ROLE_ID=123456789012345678

# Обзыватель (авто): шанс ответа на сообщение (0.035 = ~3.5%), кулдаун на человека (сек)
# ROASTER_MESSAGE_CHANCE=0.035
# ROASTER_MESSAGE_COOLDOWN_SEC=900
# ROASTER_TIMER_MIN_SEC=3600
# ROASTER_TIMER_MAX_SEC=21600
