# Copy to .env; never commit real credentials.
DISCORD_BOT_TOKEN=
# Optional: one server only. Empty = global commands.
DISCORD_GUILD_ID=
DISCORD_BOT_OWNER_ID=
YUMMY_APPLICATION_TOKEN=
DISCORD_MESSAGE_CONTENT_INTENT=0
DISCORD_LEGACY_COMMANDS=0
# Automatic forum imports and unsolicited roast messages are opt-in.
YUMMY_BACKGROUND_SYNC=0
YUMMY_SYNC_INTERVAL_SEC=600
ROASTER_AUTOMATION_ENABLED=0
# Optional migration of existing forum IDs:
# FORUM_CHANNEL_ID=
# LIST_FORUM_CHANNEL_ID=
